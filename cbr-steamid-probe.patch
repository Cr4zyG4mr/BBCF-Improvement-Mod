diff --git a/src/SteamApiWrapper/SteamUserWrapper.cpp b/src/SteamApiWrapper/SteamUserWrapper.cpp
--- a/src/SteamApiWrapper/SteamUserWrapper.cpp
+++ b/src/SteamApiWrapper/SteamUserWrapper.cpp
@@ -33,5 +33,13 @@
 CSteamID SteamUserWrapper::GetSteamID()
 {
 	LOG(7, "GetSteamID\n");
-	return m_SteamUser->GetSteamID();
+	const CSteamID steamId = m_SteamUser->GetSteamID();
+	static unsigned long long lastLoggedSteamId = 0;
+	const unsigned long long steamId64 = static_cast<unsigned long long>(steamId.ConvertToUint64());
+	if (steamId64 != 0 && steamId64 != lastLoggedSteamId)
+	{
+		lastLoggedSteamId = steamId64;
+		ForceLog("[CBR-ID-PROBE] local GetSteamID=%llu", static_cast<unsigned long long>(steamId64));
+	}
+	return steamId;
 }
