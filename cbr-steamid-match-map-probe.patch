+
+void RoomManager::ResetCbrIdentityProbe()
+{
+	m_cbrIdentityLastReport.clear();
+	m_cbrIdentityNameRequests.clear();
+}
+
+void RoomManager::LogCbrMatchIdentities(const char* phase,
+	const std::string& cbrP1Name, const std::string& cbrP2Name)
+{
+	std::ostringstream report;
+	RoomType roomType = RoomType_Replay;
+	if (!IsRoomFunctional() || !TryGetRoomType(&roomType) || !m_pSteamFriends)
+	{
+		report << "unresolved: room-or-steam-not-ready";
+	}
+	else if (roomType != RoomType_Ranked && roomType != RoomType_MatchSpectate &&
+		roomType != RoomType_Lobby && roomType != RoomType_FFA && roomType != RoomType_Training)
+	{
+		report << "unresolved: unsupported-room-type=" << static_cast<unsigned int>(roomType);
+	}
+	else
+	{
+		std::vector<CbrMatchMember> members;
+		for (unsigned int i = 0; i < MAX_PLAYERS_IN_ROOM; ++i)
+		{
+			const RoomMemberEntry* entry = GetRoomMemberEntryByIndex(static_cast<uint16_t>(i));
+			if (entry)
+				members.push_back({ entry->steamId, entry->matchId, i, entry->matchPlayerIndex });
+		}
+		int ffaLocalSlot = -1;
+		if (roomType == RoomType_FFA && m_pFFAThisPlayerIndex &&
+			!IsBadReadPtr(m_pFFAThisPlayerIndex, sizeof(*m_pFFAThisPlayerIndex)))
+			ffaLocalSlot = *m_pFFAThisPlayerIndex;
+
+		const uint64_t localId = m_thisPlayerSteamID.ConvertToUint64();
+		const auto result = ResolveCbrMatchIdentity(members, localId,
+			roomType == RoomType_Ranked, roomType == RoomType_FFA, ffaLocalSlot);
+		report << "roomType=" << static_cast<unsigned int>(roomType)
+			<< " local=" << localId << " status=" << result.reason;
+		if (result.resolved)
+		{
+			for (unsigned int slot = 0; slot < 2; ++slot)
+			{
+				const auto& player = result.players[slot];
+				const bool isLocal = player.steamId == localId;
+				const char* name = isLocal ? m_pSteamFriends->GetPersonaName()
+					: m_pSteamFriends->GetFriendPersonaName(CSteamID(player.steamId));
+				const bool namePending = !name || !*name || std::string(name) == "[unknown]";
+				if (namePending && !isLocal &&
+					std::find(m_cbrIdentityNameRequests.begin(), m_cbrIdentityNameRequests.end(), player.steamId)
+					== m_cbrIdentityNameRequests.end())
+				{
+					m_cbrIdentityNameRequests.push_back(player.steamId);
+					m_pSteamFriends->RequestUserInformation(CSteamID(player.steamId), true);
+				}
+				// Steam names are metadata. Never use equality with CBR's sanitized
+				// name to assign a side or pick between duplicate display names.
+				report << " | P" << slot + 1 << " steamid=" << player.steamId
+					<< " local=" << isLocal << " member=" << player.roomIndex
+					<< " match=" << player.matchId << " steamName='" << (namePending ? "<pending>" : name)
+					<< "' cbrName='" << (slot == 0 ? cbrP1Name : cbrP2Name) << "'";
+			}
+		}
+		else
+		{
+			// A raw roster makes an unresolved result useful without guessing an ID.
+			for (const auto& member : members)
+				report << " | member=" << member.roomIndex << " steamid=" << member.steamId
+					<< " match=" << member.matchId << " rawSlot=" << member.slot;
+		}
+	}
+	const std::string text = report.str();
+	if (text != m_cbrIdentityLastReport)
+	{
+		m_cbrIdentityLastReport = text;
+		ForceLog("[CBR-ID-MAP] phase=%s %s", phase, text.c_str());
+	}
+}
 
