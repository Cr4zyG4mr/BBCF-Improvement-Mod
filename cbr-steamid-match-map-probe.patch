diff --git a/src/Network/CbrMatchIdentity.h b/src/Network/CbrMatchIdentity.h
new file mode 100644
--- /dev/null
+++ b/src/Network/CbrMatchIdentity.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Copied room data only: resolving identity never reads game memory or Steam.
+struct CbrMatchMember
+{
+    uint64_t steamId = 0;
+    uint32_t matchId = 0;
+    unsigned int roomIndex = 0;
+    unsigned int slot = 0;
+};
+
+struct CbrMatchIdentityResult
+{
+    bool resolved = false;
+    const char* reason = "local-player-missing";
+    std::array<CbrMatchMember, 2> players{};
+};
+
+inline CbrMatchIdentityResult ResolveCbrMatchIdentity(
+    const std::vector<CbrMatchMember>& members, uint64_t localId,
+    bool ranked, bool freeForAll, int ffaLocalSlot)
+{
+    CbrMatchIdentityResult result;
+    const CbrMatchMember* local = nullptr;
+    for (std::size_t i = 0; i < members.size(); ++i)
+    {
+        if (members[i].steamId == 0)
+        {
+            result.reason = "invalid-steamid";
+            return result;
+        }
+        for (std::size_t j = 0; j < i; ++j)
+        {
+            if (members[i].steamId == members[j].steamId)
+            {
+                result.reason = "duplicate-steamid";
+                return result;
+            }
+        }
+        if (members[i].steamId == localId)
+            local = &members[i];
+    }
+    if (!local)
+        return result;
+
+    // Ranked can use a two-person room with matchId zero. Accept that only
+    // with exactly two members and explicit, distinct P1/P2 slots below.
+    if (local->matchId == 0 && (!ranked || members.size() != 2))
+    {
+        result.reason = "match-id-not-ready";
+        return result;
+    }
+    if ((freeForAll && (ffaLocalSlot < 0 || ffaLocalSlot > 1)) ||
+        (!freeForAll && local->slot > 1))
+    {
+        result.reason = "local-side-unresolved-or-spectator";
+        return result;
+    }
+
+    bool occupied[2] = { false, false };
+    for (const CbrMatchMember& member : members)
+    {
+        if (member.matchId != local->matchId)
+            continue;
+        // FFA's side comes from its separate local-side pointer. More than
+        // one other member in this match is ambiguous; never pick the first.
+        const unsigned int slot = freeForAll
+            ? static_cast<unsigned int>(member.steamId == localId ? ffaLocalSlot : 1 - ffaLocalSlot)
+            : member.slot;
+        if (slot > 1)
+            continue;
+        if (occupied[slot])
+        {
+            result.reason = "duplicate-player-slot";
+            return result;
+        }
+        occupied[slot] = true;
+        result.players[slot] = member;
+        result.players[slot].slot = slot;
+    }
+    result.resolved = occupied[0] && occupied[1];
+    result.reason = result.resolved ? "resolved" : "opponent-not-ready";
+    return result;
+}
