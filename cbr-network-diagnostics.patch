+namespace
+{
+SteamNetDiag::Counters g_netDiagnostics;
+
+struct NetDiagnosticLastError
+{
+	DWORD saved = GetLastError();
+	~NetDiagnosticLastError() { SetLastError(saved); }
+};
+
+// Pointer discovery belongs to the existing hooks. Failed diagnostic reads must
+// not become a new game crash, including during startup and shutdown transitions.
+int NetDiagnosticValue(const int* value)
+{
+	__try { return value ? *value : -1; }
+	__except (EXCEPTION_EXECUTE_HANDLER) { return -1; }
+}
+
+long long NetDiagnosticAge(unsigned long long now, unsigned long long then)
+{
+	return then ? static_cast<long long>(now >= then ? now - then : 0) : -1;
+}
+}
+
+#define NETDIAG_LOG(...) do { NetDiagnosticLastError preserve; ForceLog(__VA_ARGS__); } while (false)
+
+unsigned long long SteamNetworkingWrapper::DiagnosticCallbacksBegin()
+{
+	if (!IsLoggingEnabled()) return 0;
+	NetDiagnosticLastError preserve;
+	const auto now = GetTickCount64();
+	g_netDiagnostics.CallbacksBegin(now);
+	return now;
+}
+
+void SteamNetworkingWrapper::DiagnosticCallbacksEnd(unsigned long long started)
+{
+	if (!started) return;
+	NetDiagnosticLastError preserve;
+	const auto now = GetTickCount64();
+	g_netDiagnostics.CallbacksEnd(now, now - started);
+}
+
+void SteamNetworkingWrapper::DiagnosticFailure(CSteamID remote, int error)
+{
+	if (!IsLoggingEnabled()) return;
+	NetDiagnosticLastError preserve;
+	const auto now = GetTickCount64();
+	const auto id = static_cast<unsigned long long>(remote.ConvertToUint64());
+	g_netDiagnostics.Lifecycle(id, SteamNetDiag::Counters::Failure, false, error, now);
+	if (g_netDiagnostics.AllowEventLog(now))
+		NETDIAG_LOG("[NETDIAG] event=connect-fail tick=%llu peer=%llu error=%d", now, id, error);
+}
