diff --git a/src/SteamApiWrapper/SteamNetworkDiagnostics.h b/src/SteamApiWrapper/SteamNetworkDiagnostics.h
new file mode 100644
index 0000000..8352047
--- /dev/null
+++ b/src/SteamApiWrapper/SteamNetworkDiagnostics.h
@@ -0,0 +1,197 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// Observation only: fixed storage, no packet contents, no waiting on another
+// thread, and no Steam calls or disk IO while holding the counter lock.
+namespace SteamNetDiag
+{
+using Count = unsigned long long;
+constexpr unsigned MaxPeers = 16;
+constexpr unsigned MaxChannels = 4;
+constexpr Count SampleMs = 1000;
+constexpr Count RetainMs = 60000;
+
+struct Channel
+{
+	bool used = false;
+	int id = 0;
+	Count sends = 0, accepted = 0, received = 0;
+};
+
+struct Peer
+{
+	Count id = 0, serial = 0, touched = 0;
+	Count sends = 0, accepted = 0, sentBytes = 0, received = 0, receivedBytes = 0;
+	Count lastSend = 0, lastAccepted = 0, lastReceive = 0;
+	Count maxSendMs = 0, maxReadMs = 0;
+	Count accepts = 0, closes = 0, channelCloses = 0, failures = 0;
+	int lastError = -1, lastSendType = -1;
+	bool closed = false;
+	std::array<Channel, MaxChannels> channels{};
+	Count channelOverflow = 0;
+};
+
+struct Activity
+{
+	Count frames = 0, lastFrame = 0, maxFrameGapMs = 0;
+	Count callbacksBegin = 0, callbacksEnd = 0, lastCallbacksBegin = 0, lastCallbacksEnd = 0;
+	Count maxCallbacksMs = 0, maxCallbacksGapMs = 0;
+	Count polls = 0, available = 0, reads = 0, readOK = 0;
+	Count lastPoll = 0, lastRead = 0, maxPollMs = 0, maxReadMs = 0;
+	int lastPollChannel = -1, lastReadChannel = -1;
+};
+
+struct Snapshot
+{
+	Count tick = 0, intervalMs = 0, evictions = 0, skipped = 0, eventsSuppressed = 0;
+	Activity activity{};
+	std::array<Peer, MaxPeers> peers{};
+};
+
+class Counters
+{
+	std::atomic_flag busy = ATOMIC_FLAG_INIT;
+	std::atomic<unsigned> skipped{0};
+	Activity activity{};
+	std::array<Peer, MaxPeers> peers{};
+	Count serial = 0, evictions = 0, lastSample = 0, lastTraffic = 0;
+	Count eventWindow = 0, eventCount = 0, eventsSuppressed = 0;
+
+	struct Guard
+	{
+		Counters& owner;
+		bool held;
+		explicit Guard(Counters& value) : owner(value), held(!owner.busy.test_and_set(std::memory_order_acquire))
+		{
+			if (!held) owner.skipped.fetch_add(1, std::memory_order_relaxed);
+		}
+		~Guard() { if (held) owner.busy.clear(std::memory_order_release); }
+	};
+
+	Peer& Find(Count id, Count now)
+	{
+		if (now > lastTraffic) lastTraffic = now;
+		Peer* oldest = &peers[0];
+		for (auto& peer : peers)
+		{
+			if (peer.id == id) { if (now > peer.touched) peer.touched = now; return peer; }
+			if (!peer.id || (oldest->id && peer.touched < oldest->touched)) oldest = &peer;
+		}
+		if (oldest->id) ++evictions;
+		*oldest = Peer{};
+		oldest->id = id;
+		oldest->serial = ++serial;
+		oldest->touched = now;
+		return *oldest;
+	}
+
+	Channel* FindChannel(Peer& peer, int id)
+	{
+		for (auto& channel : peer.channels) if (channel.used && channel.id == id) return &channel;
+		for (auto& channel : peer.channels) if (!channel.used)
+		{
+			channel.used = true;
+			channel.id = id;
+			return &channel;
+		}
+		++peer.channelOverflow;
+		return nullptr;
+	}
+
+	static void Max(Count& value, Count sample) { if (sample > value) value = sample; }
+
+public:
+	bool AllowEventLog(Count now)
+	{
+		Guard guard(*this); if (!guard.held) return false;
+		if (now - eventWindow >= SampleMs) { eventWindow = now; eventCount = 0; }
+		if (eventCount >= 32) { ++eventsSuppressed; return false; }
+		++eventCount;
+		return true;
+	}
+
+	void Send(Count id, int channel, int type, unsigned bytes, bool ok, Count now, Count elapsed)
+	{
+		if (!id) return;
+		Guard guard(*this); if (!guard.held) return;
+		auto& peer = Find(id, now);
+		++peer.sends; peer.lastSend = now; peer.lastSendType = type;
+		// A send after close is a new connection attempt, even when it fails.
+		peer.closed = false;
+		Max(peer.maxSendMs, elapsed);
+		if (ok) { ++peer.accepted; peer.sentBytes += bytes; peer.lastAccepted = now; }
+		if (auto* stream = FindChannel(peer, channel)) { ++stream->sends; if (ok) ++stream->accepted; }
+	}
+
+	void Read(Count id, int channel, unsigned bytes, bool ok, Count now, Count elapsed)
+	{
+		Guard guard(*this); if (!guard.held) return;
+		++activity.reads; activity.lastRead = now; activity.lastReadChannel = channel;
+		Max(activity.maxReadMs, elapsed);
+		if (!ok) return; // No packet is not itself a connection error.
+		++activity.readOK;
+		if (!id) return;
+		auto& peer = Find(id, now);
+		++peer.received; peer.receivedBytes += bytes; peer.lastReceive = now; peer.closed = false;
+		Max(peer.maxReadMs, elapsed);
+		if (auto* stream = FindChannel(peer, channel)) ++stream->received;
+	}
+
+	void Poll(int channel, bool available, Count now, Count elapsed)
+	{
+		Guard guard(*this); if (!guard.held) return;
+		++activity.polls; if (available) ++activity.available;
+		activity.lastPoll = now; activity.lastPollChannel = channel;
+		Max(activity.maxPollMs, elapsed);
+	}
+
+	enum Event { Accept, CloseSession, CloseChannel, Failure };
+	void Lifecycle(Count id, Event event, bool ok, int error, Count now)
+	{
+		if (!id) return;
+		Guard guard(*this); if (!guard.held) return;
+		auto& peer = Find(id, now);
+		switch (event)
+		{
+		case Accept: ++peer.accepts; if (ok) peer.closed = false; break;
+		case CloseSession: ++peer.closes; if (ok) peer.closed = true; break;
+		case CloseChannel: ++peer.channelCloses; break; // Other channels may still be open.
+		case Failure: ++peer.failures; peer.lastError = error; break;
+		}
+	}
+
+	void CallbacksBegin(Count now)
+	{
+		Guard guard(*this); if (!guard.held) return;
+		if (activity.lastCallbacksBegin) Max(activity.maxCallbacksGapMs, now - activity.lastCallbacksBegin);
+		++activity.callbacksBegin; activity.lastCallbacksBegin = now;
+	}
+	void CallbacksEnd(Count now, Count elapsed)
+	{
+		Guard guard(*this); if (!guard.held) return;
+		++activity.callbacksEnd; activity.lastCallbacksEnd = now;
+		Max(activity.maxCallbacksMs, elapsed);
+	}
+
+	bool Frame(Count now, Snapshot& out)
+	{
+		Guard guard(*this); if (!guard.held) return false;
+		if (activity.lastFrame) Max(activity.maxFrameGapMs, now - activity.lastFrame);
+		++activity.frames; activity.lastFrame = now;
+		if (!lastTraffic || (now >= lastTraffic && now - lastTraffic > RetainMs) || now - lastSample < SampleMs) return false;
+		out.tick = now; out.intervalMs = lastSample ? now - lastSample : 0;
+		out.activity = activity; out.peers = peers;
+		out.evictions = evictions; out.skipped = skipped.load(std::memory_order_relaxed);
+		out.eventsSuppressed = eventsSuppressed;
+		lastSample = now;
+		// Counters are cumulative; maxima describe the interval since the last snapshot.
+		activity.maxFrameGapMs = activity.maxCallbacksMs = activity.maxCallbacksGapMs = 0;
+		activity.maxPollMs = activity.maxReadMs = 0;
+		for (auto& peer : peers) peer.maxSendMs = peer.maxReadMs = 0;
+		return true;
+	}
+};
+}
