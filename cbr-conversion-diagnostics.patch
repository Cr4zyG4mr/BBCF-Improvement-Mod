+namespace {
+std::string ReportInputs(const std::vector<int>& values) {
+    std::ostringstream out;
+    for (int value : values) {
+        if (out.tellp() > 0) out << ' ';
+        if (value < 0) { out << "release:"; value = -value; }
+        switch (value) {
+        case 0: out << '_'; break;
+        case 16: out << 'A'; break;
+        case 32: out << 'B'; break;
+        case 64: out << 'C'; break;
+        case 128: out << 'D'; break;
+        case 1100: out << "forward"; break;
+        case 1101: out << "back"; break;
+        case 1102: out << "up"; break;
+        case 1103: out << "down"; break;
+        default: out << value; break;
+        }
+    }
+    return out.str();
+}
 
+std::string ReportCommands(const std::vector<inputMemory>& commands) {
+    std::string out;
+    for (const auto& command : commands) {
+        if (!out.empty()) out += " OR ";
+        out += command.name + "[" + ReportInputs(command.inputs) + "]";
+    }
+    return out;
+}
 
+std::string ReportFrame(CbrReplayFile& converter, const char* stage, int sample,
+    int sourceSample, const Metadata& metadata, int encoded, bool retained) {
+    std::ostringstream out;
+    out << stage << " sample=" << sample << " source_sample=" << sourceSample
+        << " game_frame=" << metadata.frame_count_minus_1
+        << " retained=" << retained << " input=" << encoded
+        << " facing=" << (metadata.facing ? "left" : "right")
+        << " relative=[" << ReportInputs(converter.DeconstructInput(encoded, metadata.facing)) << ']'
+        << " action=" << metadata.currentAction[0] << " opponent_action=" << metadata.currentAction[1]
+        << " self_hit=" << metadata.hitThisFrame[0] << " opponent_hit=" << metadata.hitThisFrame[1]
+        << " self_block=" << metadata.BlockThisFrame[0] << " opponent_block=" << metadata.BlockThisFrame[1]
+        << '\n';
+    return out.str();
+}
+}
 
