--- a/src/Game/MatchState.cpp
+++ b/src/Game/MatchState.cpp
@@ -82,3 +82,22 @@ void MatchState::OnMatchInit()
 	GetMusicManager().OnMatchInit();
 
+	// The legacy CBR subsystem starts automatic Versus/Online recording from the
+	// match lifecycle. Keep it behind the same readiness checks used by the live
+	// input hooks so entering a match cannot feed it half-constructed CharData.
+	if (g_gameVals.pGameMode != nullptr &&
+		!g_interfaces.player1.IsCharDataNullPtr() &&
+		!g_interfaces.player2.IsCharDataNullPtr())
+	{
+		const int gameMode = *g_gameVals.pGameMode;
+		if (gameMode == GameMode_Training ||
+			gameMode == GameMode_Versus ||
+			gameMode == GameMode_Online)
+		{
+			g_interfaces.cbrInterface.OnMatchInit(
+				*g_interfaces.player1.GetData(),
+				*g_interfaces.player2.GetData(),
+				gameMode);
+		}
+	}
+
