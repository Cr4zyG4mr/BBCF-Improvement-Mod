diff --git a/src/CBR/CbrIdentity.h b/src/CBR/CbrIdentity.h
new file mode 100644
index 0000000..2401d33
--- /dev/null
+++ b/src/CBR/CbrIdentity.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstdint>
+#include <string>
+
+// A name is only an identity for legacy/offline data. Never match an unknown
+// identity to a Steam account just because their display names are equal.
+inline bool SameCbrIdentity(uint64_t a, const std::string& aName,
+    uint64_t b, const std::string& bName)
+{
+    return a == b && (a != 0 || aName == bName);
+}
+
+inline std::string CbrFileStem(const std::string& character,
+    const std::string& name, uint64_t steamId)
+{
+    return character + (steamId ? "__steam_" + std::to_string(steamId) : name);
+}
