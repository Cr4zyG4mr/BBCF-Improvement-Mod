+CbrMatchIdentityResult RoomManager::ResolveCbrCurrentMatch(std::vector<CbrMatchMember>& members) const
+{
+    members.clear();
+    RoomType roomType = RoomType_Replay;
+    CbrMatchIdentityResult unavailable;
+    unavailable.reason = "room-or-steam-not-ready";
+    if (!IsRoomFunctional() || !TryGetRoomType(&roomType) || !m_pSteamFriends)
+        return unavailable;
+    if (roomType != RoomType_Ranked && roomType != RoomType_MatchSpectate &&
+        roomType != RoomType_Lobby && roomType != RoomType_FFA && roomType != RoomType_Training) {
+        unavailable.reason = "unsupported-room-type";
+        return unavailable;
+    }
+		for (unsigned int i = 0; i < MAX_PLAYERS_IN_ROOM; ++i)
+		{
+			const RoomMemberEntry* entry = GetRoomMemberEntryByIndex(static_cast<uint16_t>(i));
+			if (entry)
+				members.push_back({ entry->steamId, entry->matchId, i, entry->matchPlayerIndex });
+		}
+		int ffaLocalSlot = -1;
+		if (roomType == RoomType_FFA && m_pFFAThisPlayerIndex &&
+			!IsBadReadPtr(m_pFFAThisPlayerIndex, sizeof(*m_pFFAThisPlayerIndex)))
+			ffaLocalSlot = *m_pFFAThisPlayerIndex;
+
+    return ResolveCbrMatchIdentity(members, m_thisPlayerSteamID.ConvertToUint64(),
+        roomType == RoomType_Ranked, roomType == RoomType_FFA, ffaLocalSlot);
+}
+
+bool RoomManager::GetCbrMatchPlayers(std::array<uint64_t, 2>& ids,
+    std::array<std::string, 2>& names, uint64_t& localId) const
+{
+    ids = {};
+    names = {};
+    localId = m_thisPlayerSteamID.ConvertToUint64();
+    std::vector<CbrMatchMember> members;
+    const auto result = ResolveCbrCurrentMatch(members);
+    if (!result.resolved) return false;
+    for (unsigned slot = 0; slot < 2; ++slot) {
+        ids[slot] = result.players[slot].steamId;
+        const char* name = ids[slot] == localId ? m_pSteamFriends->GetPersonaName()
+            : m_pSteamFriends->GetFriendPersonaName(CSteamID(ids[slot]));
+        if (name && *name && std::string(name) != "[unknown]") names[slot] = name;
+    }
+    return true;
+}
