diff --git a/src/CBR/CbrFileIO.h b/src/CBR/CbrFileIO.h
new file mode 100644
index 0000000..a2ba04f
--- /dev/null
+++ b/src/CBR/CbrFileIO.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "CbrData.h"
+#include "CbrFileMetadata.h"
+#include "CbrArchive.h"
+#include <boost/archive/binary_iarchive.hpp>
+
+// Both historic layouts are supported: CbrData alone, or the four-field
+// metadata prefix followed by CbrData. Class versions handle the ID field.
+inline CbrData ReadCbrDataArchive(const std::string& filename)
+{
+    try {
+        std::ifstream input(filename, std::ios::binary);
+        boost::iostreams::filtering_istream compressed;
+        compressed.push(boost::iostreams::gzip_decompressor());
+        compressed.push(input);
+        boost::archive::binary_iarchive archive(compressed);
+        CbrData data;
+        archive >> data;
+        return data;
+    } catch (const std::exception&) {
+        std::ifstream input(filename, std::ios::binary);
+        boost::iostreams::filtering_istream compressed;
+        compressed.push(boost::iostreams::gzip_decompressor());
+        compressed.push(input);
+        boost::archive::binary_iarchive archive(compressed);
+        std::string character, player, opponents;
+        int count = 0;
+        CbrData data;
+        archive >> character >> player >> opponents >> count >> data;
+        return data;
+    }
+}
