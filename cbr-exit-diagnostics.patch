+HANDLE DuplicateDebugLogHandle()
+{
+    const std::lock_guard<std::mutex> lock(g_logMutex);
+    if (!g_oFile) return INVALID_HANDLE_VALUE;
+    fflush(g_oFile);
+    HANDLE duplicate = INVALID_HANDLE_VALUE;
+    const HANDLE source = reinterpret_cast<HANDLE>(_get_osfhandle(_fileno(g_oFile)));
+    if (!DuplicateHandle(GetCurrentProcess(), source, GetCurrentProcess(), &duplicate,
+        0, FALSE, DUPLICATE_SAME_ACCESS)) return INVALID_HANDLE_VALUE;
+    return duplicate;
+}
