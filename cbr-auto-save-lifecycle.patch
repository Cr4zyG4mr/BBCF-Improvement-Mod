 #define DEFAULT_ALPHA 0.87f
 
+namespace
+{
+	bool HasPendingCbrAutoRecordings()
+	{
+		return !g_interfaces.cbrInterface.recordBufferP1.empty() ||
+			!g_interfaces.cbrInterface.recordBufferP2.empty();
+	}
+
+	void UpdateCbrAutoRecordLifecycle()
+	{
+		if (g_gameVals.pGameState == nullptr)
+			return;
+
+		CbrInterface& cbr = g_interfaces.cbrInterface;
+		const int gameState = *g_gameVals.pGameState;
+
+		// Belt-and-suspenders parity with the old render loop: if a match-transition
+		// hook was skipped for any reason, leaving state 15 still finalizes the active
+		// automatic recording before the save logic below can run.
+		if (gameState != GameState_InMatch && cbr.autoRecordActive)
+			cbr.EndCbrActivities();
+
+		// Match the old AI mod's post-match behavior. EndCbrActivities() marks an
+		// automatic recording finished and leaves the completed replay(s) buffered.
+		// The results screen reports that pending data before it is saved/discarded.
+		if (cbr.autoRecordFinished)
+		{
+			if (gameState == GameState_VictoryScreen)
+			{
+				const int pending = cbr.getAutoRecordReplayAmount();
+				if (cbr.autoRecordConfirmation)
+					g_notificationBar->AddNotification(
+						"Currently %d CBR replays unsaved. Return to lobby/character select to save them, or use %s to discard.",
+						pending,
+						HotkeyManager::DisplayString(HotkeyManager::GetBinding(HotkeyManager::Hotkey_CbrDiscardPending)).c_str());
+				else
+					g_notificationBar->AddNotification(
+						"Currently %d CBR replays unsaved. Use %s to save or %s to discard.",
+						pending,
+						HotkeyManager::DisplayString(HotkeyManager::GetBinding(HotkeyManager::Hotkey_CbrSavePending)).c_str(),
+						HotkeyManager::DisplayString(HotkeyManager::GetBinding(HotkeyManager::Hotkey_CbrDiscardPending)).c_str());
+			}
+			cbr.autoRecordFinished = false;
+		}
+
+		// This is the original "Auto Saving In Lobby" predicate: keep data pending
+		// through Versus (14), the match (15), and the first victory state (16).
+		// As soon as BBCF advances beyond those states, saveReplayDataInMenu merges
+		// the buffered replays into each player's existing local .cbr file.
+		if (cbr.autoRecordConfirmation &&
+			gameState != GameState_VersusScreen &&
+			gameState != GameState_InMatch &&
+			gameState != GameState_VictoryScreen &&
+			gameState != -1 &&
+			HasPendingCbrAutoRecordings() &&
+			!cbr.threadActiveCheck())
+		{
+			cbr.autoRecordSaveCompleted = false;
+			g_notificationBar->AddNotification("Saving CBR replays... please don't close the game.");
+			LOG(1, "[CBR] Auto-saving %d buffered replay(s) after match.\n", cbr.getAutoRecordReplayAmount());
+			cbr.threadSaveReplay(true);
+		}
+
+		if (HotkeyManager::WasPressed(HotkeyManager::Hotkey_CbrSavePending))
+		{
+			if (!HasPendingCbrAutoRecordings())
+				g_notificationBar->AddNotification("No pending CBR replays to save.");
+			else if (gameState == GameState_InMatch)
+				g_notificationBar->AddNotification("CBR recordings cannot be saved during a match.");
+			else if (!cbr.threadActiveCheck())
+			{
+				cbr.autoRecordSaveCompleted = false;
+				g_notificationBar->AddNotification("Saving CBR replays... please don't close the game.");
+				cbr.threadSaveReplay(true);
+			}
+		}
+
+		if (HotkeyManager::WasPressed(HotkeyManager::Hotkey_CbrDiscardPending))
+		{
+			if (!HasPendingCbrAutoRecordings())
+				g_notificationBar->AddNotification("No pending CBR replays to discard.");
+			else if (!cbr.threadActiveCheck())
+			{
+				cbr.clearAutomaticRecordReplays();
+				g_notificationBar->AddNotification("Pending CBR replays discarded.");
+			}
+		}
+
+		if (cbr.threadCheckSaving())
+		{
+			g_notificationBar->AddNotification("CBR replay saving completed.");
+			LOG(1, "[CBR] Buffered replay save completed.\n");
+		}
+	}
+}
